{
  "name": "storefront",
  "private": true,
  "version": "1.0.0",
  "description": "SOHOFI BRICO - public e-commerce storefront (SSR React + Express + Knex)",
  "type": "module",
  "scripts": {
    "dev": "node server/ssr.js",
    "dev:api": "node server/index.js",
    "db:setup": "node server/db/migrate.js && node server/db/seed.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "build": "vite build",
    "preview": "vite preview",
    "start:ssr": "node server/ssr.js",
    "start:api": "node server/index.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "i18next": "^24.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.11.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^7.1.1",
    "sirv": "^3.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2",
    "same-runtime": "^0.0.1",
    "react-grab": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.0.7"
  }
}
