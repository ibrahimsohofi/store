# ─── runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000               # SSR + web (map says 4000 in production)
API_PORT=4001           # standalone REST API
SITE_URL=http://localhost:3000
LOG_LEVEL=info

# ─── database ───────────────────────────────────────────────────────────────
# dev sandbox -> better-sqlite3 ; production -> mysql2 (products_manager schema)
DB_CLIENT=better-sqlite3
DB_FILE=./data/storefront.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sohofi_shop
DB_PASSWORD=
DB_NAME=products_manager

# ─── auth ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── shop ───────────────────────────────────────────────────────────────────
DEFAULT_LOCALE=fr
CURRENCY=MAD
VAT_RATE=0.20
FREE_SHIPPING_THRESHOLD=600

# ─── client (Vite-exposed) ──────────────────────────────────────────────────
VITE_SITE_URL=http://localhost:3000
